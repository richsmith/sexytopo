<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="org.hwyl.sexytopo.control.activity.DistoXCalibrationActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/panelBackground">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/panelBackground"
            app:titleTextColor="@color/white" />

    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/lightBackground"
            android:padding="16dp">

            <!-- Calibration Mode Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardElevation="0dp"
                app:cardCornerRadius="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/calibration_title_mode"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="?attr/colorOnSurface"
                        android:paddingBottom="12dp" />

                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <Button
                            android:id="@+id/calibration_start"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:text="@string/calibration_start"
                            android:onClick="requestStartCalibration" />

                        <Button
                            android:id="@+id/calibration_stop"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="@string/calibration_stop"
                            android:onClick="requestStopCalibration" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Readings Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardElevation="0dp"
                app:cardCornerRadius="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/calibration_title_readings"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="?attr/colorOnSurface"
                        android:paddingBottom="12dp" />

                    <LinearLayout style="@style/StatsRow">
                        <TextView
                            style="@style/StatsLabel"
                            android:text="@string/calibration_index" />
                        <TextView
                            style="@style/StatsValue"
                            android:id="@+id/calibration_index" />
                    </LinearLayout>

                    <LinearLayout style="@style/StatsRow">
                        <TextView
                            style="@style/StatsLabel"
                            android:text="@string/calibration_sets" />
                        <TextView
                            style="@style/StatsValue"
                            android:id="@+id/calibration_sets" />
                    </LinearLayout>

                    <View style="@style/StatsDivider" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/calibration_coverage"
                        android:textAppearance="?attr/textAppearanceLabelLarge"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:paddingBottom="4dp" />

                    <LinearLayout style="@style/StatsRow">
                        <TextView
                            style="@style/StatsLabel"
                            android:text="@string/calibration_pointing_horizontal" />
                        <TextView
                            style="@style/StatsValue"
                            android:id="@+id/calibration_coverage_horizontal" />
                    </LinearLayout>
                    <LinearLayout style="@style/StatsRow">
                        <TextView
                            style="@style/StatsLabel"
                            android:text="@string/direction_up" />
                        <TextView
                            style="@style/StatsValue"
                            android:id="@+id/calibration_coverage_up" />
                    </LinearLayout>
                    <LinearLayout style="@style/StatsRow">
                        <TextView
                            style="@style/StatsLabel"
                            android:text="@string/direction_down" />
                        <TextView
                            style="@style/StatsValue"
                            android:id="@+id/calibration_coverage_down" />
                    </LinearLayout>
                    <LinearLayout style="@style/StatsRow">
                        <TextView
                            style="@style/StatsLabel"
                            android:text="@string/calibration_coverage_corners_up" />
                        <TextView
                            style="@style/StatsValue"
                            android:id="@+id/calibration_coverage_corner_up" />
                    </LinearLayout>
                    <LinearLayout style="@style/StatsRow">
                        <TextView
                            style="@style/StatsLabel"
                            android:text="@string/calibration_coverage_corners_down" />
                        <TextView
                            style="@style/StatsValue"
                            android:id="@+id/calibration_coverage_corner_down" />
                    </LinearLayout>

                    <View style="@style/StatsDivider" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/calibration_next_step"
                        android:textAppearance="?attr/textAppearanceLabelLarge"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:paddingBottom="4dp" />

                    <LinearLayout style="@style/StatsRow">
                        <TextView
                            style="@style/StatsLabel"
                            android:text="@string/calibration_direction" />
                        <TextView
                            style="@style/StatsValue"
                            android:id="@+id/calibration_next_direction" />
                    </LinearLayout>

                    <LinearLayout style="@style/StatsRow">
                        <TextView
                            style="@style/StatsLabel"
                            android:text="@string/calibration_orientation" />
                        <TextView
                            style="@style/StatsValue"
                            android:id="@+id/calibration_next_orientation" />
                    </LinearLayout>

                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp">

                        <Button
                            android:id="@+id/calibration_load"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:text="@string/calibration_load"
                            android:onClick="requestLoadCalibration" />

                        <Button
                            android:id="@+id/calibration_save"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="@string/calibration_save"
                            android:onClick="requestSaveCalibration" />

                    </LinearLayout>

                    <Button
                        android:id="@+id/calibration_clear"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/clear"
                        android:onClick="requestClearCalibration" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Last Reading Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardElevation="0dp"
                app:cardCornerRadius="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingBottom="4dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/calibration_title_last_reading"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textColor="?attr/colorOnSurface" />

                        <Button
                            android:id="@+id/calibration_view_readings"
                            style="?attr/borderlessButtonStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/calibration_view_readings"
                            android:onClick="requestViewReadings" />

                    </LinearLayout>

                    <org.hwyl.sexytopo.control.components.CalibrationReadingView
                        android:id="@+id/calibration_last_reading"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <Button
                        android:id="@+id/calibration_delete_last"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/calibration_delete_last"
                        android:onClick="requestDeleteLast" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Result Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardElevation="0dp"
                app:cardCornerRadius="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/calibration_title_result"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="?attr/colorOnSurface"
                        android:paddingBottom="12dp" />

                    <LinearLayout style="@style/StatsRow">
                        <TextView
                            style="@style/StatsLabel"
                            android:text="@string/calibration_assessment" />
                        <TextView
                            style="@style/StatsValue"
                            android:id="@+id/calibrationFieldAssessment" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/calibration_worst_section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <View style="@style/StatsDivider" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/calibration_worst_readings"
                            android:textAppearance="?attr/textAppearanceLabelLarge"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:paddingBottom="4dp" />

                        <LinearLayout
                            android:id="@+id/calibration_worst_list"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                    </LinearLayout>

                    <Button
                        android:id="@+id/calibration_complete"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/calibration_complete"
                        android:onClick="requestCompleteCalibration" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
